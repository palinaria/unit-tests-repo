{
  "name": "unit-tests-repo",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "author": "",
  "license": "ISC",
  "scripts": {
    "test": "mocha --reporter mochawesome --reporter-options reportDir=reports,reportFilename=test-report,overwrite=true",
    "coverage": "c8 mocha test/**/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "babel src --out-dir dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": "npm run lint"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/preset-env": "^7.26.9",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "eslint": "^9.25.1",
    "eslint-plugin-mocha": "^11.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "mocha": "^11.1.0",
    "mochawesome": "^7.1.3"
  }
}
